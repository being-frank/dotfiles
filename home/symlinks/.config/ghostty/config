# Application
scrollback-limit = 1000000

# Clipboard
clipboard-read = allow
clipboard-trim-trailing-spaces = false
clipboard-write = allow
copy-on-select = clipboard

# Colors
palette = 0=#1A1B26
palette = 8=#414868

palette = 1=#F7768E
palette = 9=#F7768E

palette = 2=#73DACA
palette = 10=#73DACA

palette = 3=#E0AF68
palette = 11=#E0AF68

palette = 4=#7AA2F7
palette = 12=#7AA2F7

palette = 5=#BB9AF7
palette = 13=#BB9AF7

palette = 6=#7DCFFF
palette = 14=#7DCFFF

palette = 7=#C0CAF5
palette = 15=#C0CAF5

background = #1A1B26
foreground = #A9B1D6
cursor-color = #C0CAF5
cursor-text = #1A1B26
selection-background = #28344A
selection-foreground =


# Fonts
adjust-cell-height=1
font-family = JetBrainsMono Nerd Font Propo
font-size = 11
font-thicken = false
font-thicken-strength=1

# Window
background-blur = 20
# macos-titlebar-style = hidden
unfocused-split-opacity = 0.8
window-padding-x = 10
window-padding-y = 10
window-theme = dark
